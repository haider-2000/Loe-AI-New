# Copy to .env and fill in the real values. Never commit .env itself.
# .gitignore already keeps it out of git, but .env.example is committed, so it
# must only ever contain placeholders.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
GEMINI_API_KEY=replace_with_your_gemini_key
ADMIN_ID=8160888453
# No group allowlist any more: the bot answers in any group it is added to.
# Private chats stay reserved for the owner, which is where /backup lives.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. A second Gemini key used for one job only: deciding whether a group
# message is meant for the bot, so it can answer a plain question without its
# name in it. Leave it empty and the bot behaves exactly as it always has --
# answering only when named, mentioned or replied to.
# Use a DIFFERENT key from GEMINI_API_KEY: the gate runs on every message a group
# receives, including the ones nobody wanted answered, so sharing a key would
# spend the quota the real answers need.
# ROUTER_API_KEY=replace_with_a_second_gemini_key
# ROUTER_MODEL=gemini-3.5-flash-lite

# Where the data lives. Leave DATABASE_PATH as-is for a local run on this
# machine. On Render set DB_URL to a free remote database instead, because the
# container disk there is wiped on every restart:
#   DB_URL=libsql://your-database-name-your-org.turso.io
#   DB_AUTH_TOKEN=eyJhbGciOi...
DATABASE_PATH=data/edu_bot.db

# How often the bot pushes a fresh archive to the admin's private chat, in
# minutes. Set to 0 to turn the automatic backup off.
AUTO_BACKUP_MINUTES=0
